# ===== Secrets =====
.env
.env.*
!.env.example

# ===== Python =====
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ===== Model weights =====
# Ignore all weights by default (large binary files)...
*.pt
*.pth
*.onnx
*.engine
*.weights
# ...but keep the two models used by the project
!vision/models/yolov8n.pt
!vision/models/best.pt

# ===== Videos & media (too large for GitHub) =====
*.mp4
*.avi
*.mov
*.mkv

# ===== Runtime data =====
storage/vehicles/*
storage/plates/*
!storage/vehicles/.gitkeep
!storage/plates/.gitkeep

# ===== Logs & temp =====
*.log
*.tmp

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.vscode/
.idea/